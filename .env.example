# ---------------------------------------------------------------------------
# Akụkọ N'asụsụ Igbo — environment variables
# Copy to .env.local for local development. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Next.js (set in .env.local and in Vercel) -----------------------------

# The Convex deployment URL. `npx convex dev` writes this to .env.local for you.
# In Vercel set this to your PRODUCTION deployment URL (never the dev one).
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# The public origin of the site. Used for canonical URLs, Open Graph, the
# sitemap and robots.txt. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Vercel build (set in Vercel only) -------------------------------------

# Production deploy key from Convex Dashboard -> Settings -> URL & Deploy Key.
# Lets `npx convex deploy` run inside the Vercel build. Not needed locally.
CONVEX_DEPLOY_KEY=

# --- Convex deployment environment (NOT read from .env.local) --------------
# These live on the Convex deployment itself. Set them with `npm run setup:auth`
# (which generates the keys), or by hand with `npx convex env set NAME value`.
# Listed here so every variable is documented in one place.
#
#   JWT_PRIVATE_KEY   RSA private key (PKCS8 PEM) used to sign admin sessions.
#   JWKS              Matching public key as a JWKS JSON document.
#   SITE_URL          Origin the auth flow redirects to (same as NEXT_PUBLIC_SITE_URL).
#
# Admin credentials are NOT environment variables. The single admin account is
# created once with:  npx convex run seed:createAdmin '{"email":"...","password":"..."}'
